[Unit]
Description=Rotate BSB reporting snapshots and refresh statistics
After=postgresql.service pgbouncer.service bsb-reporting-guard.service
Requires=pgbouncer.service bsb-reporting-guard.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/bsb-reporting/rotate_reporting_snapshot.py --refresh-statistics
Nice=10
CPUQuota=25%
MemoryMax=96M
TimeoutStartSec=180
UMask=0077
